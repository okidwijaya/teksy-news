<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="400" viewBox="0 0 1200 400" role="img" aria-labelledby="title desc">
  <title id="title">KITA logo — Kickstart Ideas, Transform Applications</title>
  <desc id="desc">Logo with an orange rocket icon on the left and bold KITA text with a tagline beneath.</desc>

  <!-- Background (transparent) -->
  <rect width="100%" height="100%" fill="white"/>

  <!-- Rocket group -->
  <g id="rocket" transform="translate(80,80) scale(1.6)">
    <!-- Body -->
    <path d="M80 10 C120 10 140 30 150 70 C155 88 150 120 130 150 C110 180 70 200 40 210 C15 218 -8 210 2 190 C12 170 40 150 48 130 C55 115 50 80 60 60 C70 35 80 10 80 10 Z"
          fill="#F08A24" stroke="#F08A24"/>
    <!-- Window -->
    <circle cx="86" cy="76" r="14" fill="white"/>
    <!-- Left fin -->
    <path d="M30 170 L5 200 L50 180 Z" fill="#F08A24"/>
    <!-- Right fin -->
    <path d="M110 170 L140 200 L95 180 Z" fill="#F08A24"/>
    <!-- Flame -->
    <path d="M58 210 C70 240 85 260 92 290 C85 278 68 260 55 240 C45 225 48 220 58 210 Z" fill="#FFB84D" opacity="0.95"/>
  </g>

  <!-- KITA Text -->
  <text x="300" y="150" font-family="Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-weight="800" font-size="140" fill="#112B3A">KITA</text>

  <!-- Tagline -->
  <text x="300" y="210" font-family="Segoe UI, Roboto, Helvetica, Arial, sans-serif" font-weight="600" font-size="28" fill="#4A5568">
    KICKSTART IDEAS, TRANSFORM APPLICATIONS
  </text>

</svg>